{
  "_doc": "Enemy style for the 3D-to-pixel pipeline. Same light, bands, coverage, rim and outline rules as tools/art/samurai/samurai_style.json; ramps reuse the samurai palette wherever they can (helmet, suit=coat, cloth, boots, cyber, steel, red=visor, outlines) and add a small enemy accent set: gunmetal, olive drab, amber eye, orange strip, red-orange attack glow, talisman holo, spark, rotor blur. Material ids are written into the R channel of the id pass (id*10, max 25). Emissive channels: r = weapon/attack glow (tintable), g = eyes/visor, b = tech light strips. Palette values are technical placeholders pending art-director sign-off.",
  "rig": {"yaw": {"pelvis": -12, "spine": -18, "chest": -25, "head": -15}},
  "render": {"ao_distance": 0.12, "ao_samples": 16, "cell_pad_bottom": 0.25},
  "light": {"dir": [-0.35, 0.8, 0.5], "ambient": 0.74, "diffuse": 0.36, "ao_strength": 0.65},
  "bands": {"2": [0.7], "3": [0.64, 1.0]},
  "coverage": {"alpha": 0.5, "priority": 0.22},
  "rim": {"enabled": true, "dirs": [[-1, 0]]},
  "outlines": {"cool": "#0d0f15", "steel": "#262b35", "crimson": "#2c0a10", "olive": "#0e100b", "amber": "#3a1a06"},
